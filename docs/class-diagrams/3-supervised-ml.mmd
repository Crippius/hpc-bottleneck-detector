classDiagram
    %% ============================================
    %% ML COMPONENTS VIEW
    %% Focus: Machine Learning Detection Pipeline
    %% Backends hold fitted state and perform inference (used at analysis time).
    %% Trainers consume labelled data and produce a fitted backend (offline, CLI/scripts only).
    %% ============================================

    class SupervisedMLStrategy {
        +backend: IMLBackend
        +significance_threshold: float
        +__init__(backend: IMLBackend, significance_threshold: float)
        +diagnose(data_mgr: DataManager) List~Diagnosis~
        +get_required_metrics() List~str~
    }

    class IMLBackend {
        <<interface>>
        +predict_probabilities(window_df: DataFrame) dict~str, float~
        +save(path: str) None
        +load(path: str) IMLBackend$
    }

    class IMLTrainer {
        <<interface>>
        +train(labelled_csv_paths: List~str~, window_size: int, step_size: int, severity_threshold: float) IMLBackend
    }

    class DefaultBackend {
        -_models: dict~str, ClassifierMixin~
        -_feature_cols: dict~str, List~str~~
        -_thresholds: dict~str, float~
        -_fc_params: dict
        -_window_size: Optional~int~
        -_missing_fill_value: float
        -_training_meta: dict
        +__init__(missing_fill_value: float)
        +calibrate_thresholds(X_val: DataFrame, y_dict_val: dict~str, Series~, threshold_grid: Optional~List~float~~) dict~str, float~
        +predict_probabilities(window_df: DataFrame) dict~str, float~
        +save(path: str) None
        +load(path: str) DefaultBackend$
    }

    class DefaultTrainer {
        -_classifier: ClassifierMixin
        -_use_fdr: bool
        -_use_importance_pruning: bool
        +__init__(classifier: ClassifierMixin, use_fdr: bool, use_importance_pruning: bool)
        +train(labelled_csv_paths: List~str~, window_size: int, step_size: int, severity_threshold: float) DefaultBackend
        +from_preextracted_features(X_train: DataFrame, y_dict_train: dict~str, Series~) DefaultBackend
        +calibrate_thresholds_cv(app_features: List~Tuple~, n_splits: int, default_threshold: float) dict~str, float~
        +tune(app_features: List~Tuple~, classifier: ClassifierMixin, param_grid: Optional~dict~, n_splits: int, n_iter: int) Tuple~ClassifierMixin, dict~str, float~~$
        -_select_features(X_clean: DataFrame, y_clean: Series, col: str) Optional~DataFrame~
    }

    class AMLLibraryBackend {
        -_regressors: dict~str, MTSRegressor~
        -_window_size: int
        -_thresholds: dict~str, float~
        -_training_meta: dict
        +__init__()
        +predict_probabilities(window_df: DataFrame) dict~str, float~
        +save(path: str) None
        +load(path: str) AMLLibraryBackend$
    }

    class AMLLibraryTrainer {
        +train(labelled_csv_paths: List~str~, window_size: int, step_size: int, severity_threshold: float) AMLLibraryBackend
        +calibrate_thresholds_cv(backend: AMLLibraryBackend, labelled_csv_paths: List~str~, window_size: int, step_size: int, severity_threshold: float, n_splits: int) dict~str, float~
    }

    class DataManager {
        +job_data: DataFrame
        +job_id: str
        +get_metric(group: str, metric: str, trace: str) Series
        +get_flat_dataframe(interval_seconds: int) DataFrame
        +iterate_windows(window_size: int, step_size: int) Generator
    }

    class Diagnosis {
        <<dataclass>>
        +bottleneck_type: BottleneckType
        +severity_score: float
        +confidence: float
        +source: str
        +is_healthy: bool
        +is_unknown: bool
    }

    class BottleneckType {
        <<enumeration>>
        PIPELINE_STALL
        COMPUTE_UNDERUTILIZATION
        PRECISION_WASTE
        BRANCH_MISPREDICTION
        CACHE_PRESSURE
        INTRA_NODE_LOAD_IMBALANCE
        INTER_NODE_LOAD_IMBALANCE
        NONE
        UNKNOWN
        +get_macro_category() MacroCategoryType
    }

    %% Relationships
    SupervisedMLStrategy *-- IMLBackend : backend
    SupervisedMLStrategy --> DataManager : uses
    SupervisedMLStrategy --> Diagnosis : produces

    IMLBackend <|.. DefaultBackend : implements
    IMLBackend <|.. AMLLibraryBackend : implements
    IMLTrainer <|.. DefaultTrainer : implements
    IMLTrainer <|.. AMLLibraryTrainer : implements

    DefaultTrainer ..> DefaultBackend : produces (offline)
    AMLLibraryTrainer ..> AMLLibraryBackend : produces (offline)

    DataManager --> DefaultBackend : window_df via get_flat_dataframe
    DataManager --> AMLLibraryBackend : window_df via get_flat_dataframe

    Diagnosis --> BottleneckType : has
